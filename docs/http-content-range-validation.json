  "local_policy": {
    "range_unit": "bytes, case insensitive",
    "numeric_ceiling": "9223372036854775807",
    "upload": "One fulfilled Content-Range on PUT, matching the actual UTF-8 body length at MCP admission; direct transport also checks its declared content length.",
    "single_partial_response": "206 requires a GET Range request in the production broker, one fulfilled Content-Range and an exact received byte count.",
    "other_status": "Content-Range permitted only as an unsatisfied byte range on 416; absence on 416 remains allowed.",
    "multipart": "206 requires multipart/byteranges, a MIME boundary, at least two requested ranges, no outer Content-Range, and one fulfilled range per part.",
    "maximum_parts": 16,
    "maximum_boundary_characters": 70,
    "multipart_headers": {
      "cumulative_fields": 128,
      "cumulative_bytes": 65536,
      "per_line_bytes": 8192
    },
    "multipart_content": "Exact part byte lengths, consistent known totals covering every returned interval, mandatory closing delimiter and no premature boundary prefixes.",
    "multipart_encodings": "Absent/binary Content-Transfer-Encoding and absent/identity Content-Encoding only; folded part headers and part-level HTTP framing are denied.",
    "preserved_controls": "Known/unknown totals, byte-counted Unicode, leading zeros, reordered/coalesced parts, quoted/padded boundaries, empty media parameter slots, preamble/epilogue and optional final CRLF."
  },
