  "policy": {
    "answer_count": "One through 64 resolver entries, including duplicates. Reject empty/oversized sets before any destination socket is created; do not silently truncate.",
    "address_set": "Validate the entire set before the first dial; private, special-purpose, mapped, multicast and scoped values deny the set. Numeric addresses and the approved port remain pinned.",
    "registry": "Exclude every listed IANA special-purpose assignment, even globally reachable ones, plus multicast and the Azure platform address. IPv6 eligibility is additionally limited to 2000::/3.",
    "compatibility": "Retain IPv4, IPv6 and mixed-family sets at the count boundary and ordinary public neighbors of excluded ranges. Validated sets preserve the selected numeric destination and requested port.",
    "interpretation": "The 64-entry ceiling and public/unscoped-only policy are local restrictions; valid DNS responses and IP scopes can exist outside this broker profile."
  },
