  "policy": {
    "not_modified": "304 requires a GET/HEAD request containing If-None-Match or If-Modified-Since.",
    "scope": "Compare explicit returned representation validators for GET/HEAD 200, 206 and 304 only; do not infer origin state from absent metadata.",
    "comparison": "Strong comparison for If-Match and If-Range tags; weak comparison for If-None-Match. Commas and backslashes inside opaque tags remain literal.",
    "precedence": "If-Match suppresses If-Unmodified-Since; If-None-Match suppresses If-Modified-Since, even when a response validator is absent.",
    "if_range": "206 with an explicit corresponding validator requires the same strong ETag or equal Last-Modified timestamp. A 200 may ignore Range.",
    "dates": "Compare validated calendar components across supported HTTP-date forms without collapsing 23:59:60 into the next midnight. Reject Last-Modified later than Date in the same header block.",
    "valid_controls": "Preserve post-write validators on mutation responses, redirects/errors, unknown response validators and full/partial content when the optional If-Modified-Since evaluation is not applied.",
    "request_context": "Production Go/Python dispatch supplies the request context. Trusted parsed-response helpers without it cannot check request correlation.",
    "local_cache_restriction": "The local broker requires returned If-Match/If-Unmodified-Since agreement even for upstream caches/intermediaries that RFC 9110 permits to ignore those origin preconditions."
  },
