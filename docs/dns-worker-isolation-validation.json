{
  "as_of": "2026-09-27",
  "scope": "DNS transport worker isolation in Proxy.Serve using channel-backed listener adapters and net.Pipe. IPv4/IPv6 labels describe admitted source addresses, not live network-stack tests.",
  "finding": "A single 128-slot pool let idle TCP connections starve UDP handling, and let UDP handlers blocked writing replies starve TCP admission.",
  "change": {
    "aggregate_active_handler_limit": 128,
    "reserved_udp_workers": 64,
    "reserved_tcp_connections": 64,
    "rate_budget": "Unchanged shared 50 queries/second, burst 100. No per-client fairness added.",
    "tradeoff": "Either transport can use only its reserved 64 slots, even when the other transport is idle."
  },
  "baseline": {
    "failing_leaf_cases": [
      "TestDNSTransportWorkerIsolation/ipv4/idle-tcp",
      "TestDNSTransportWorkerIsolation/ipv4/blocked-udp-writes",
      "TestDNSTransportWorkerIsolation/ipv6/idle-tcp",
      "TestDNSTransportWorkerIsolation/ipv6/blocked-udp-writes"
    ],
