# Native Snort 3 rules retained from the user-provided Agent Guard archive.
# NOT loaded by the AX Go/Python HTTP proxy. Native validation is separate; see native-snort3/ at repository root.
# Original balanced-profile actions and network variables are retained.
# Requires a real Snort installation, matching sensors and independently configured variables.
# See README.md and source-catalog.json for source strict actions and assumptions.

# Requires packet addresses, ports, protocols or TCP flags at a separate network boundary.
block tcp $AGENT_NET any -> !$BROKER_NET any (msg:"AGENT-GUARD Outbound destination is not the sole broker"; priority:1; metadata:created_at 2026_09_26, deployment agent_guard, category perimeter; sid:9101001; rev:1;)

# Requires packet addresses, ports, protocols or TCP flags at a separate network boundary.
block tcp $AGENT_NET any -> $BROKER_NET !$BROKER_PORTS (msg:"AGENT-GUARD Outbound broker port is not allowed"; priority:1; metadata:created_at 2026_09_26, deployment agent_guard, category perimeter; sid:9101002; rev:1;)

# Requires packet addresses, ports, protocols or TCP flags at a separate network boundary.
block ip $AGENT_NET any -> any any (msg:"AGENT-GUARD Non-TCP agent egress is prohibited"; ip_proto:!6; priority:1; metadata:created_at 2026_09_26, deployment agent_guard, category perimeter; sid:9101003; rev:1;)

# Requires packet addresses, ports, protocols or TCP flags at a separate network boundary.
block tcp !$BROKER_NET any -> $AGENT_NET any (msg:"AGENT-GUARD Inbound source is not the sole broker"; priority:1; metadata:created_at 2026_09_26, deployment agent_guard, category perimeter; sid:9101004; rev:1;)

# Requires packet addresses, ports, protocols or TCP flags at a separate network boundary.
block tcp $BROKER_NET !$BROKER_PORTS -> $AGENT_NET any (msg:"AGENT-GUARD Inbound broker source port is not allowed"; priority:1; metadata:created_at 2026_09_26, deployment agent_guard, category perimeter; sid:9101005; rev:1;)

# Requires packet addresses, ports, protocols or TCP flags at a separate network boundary.
alert ip any any -> $AGENT_NET any (msg:"AGENT-GUARD Non-TCP inbound traffic requires router validation"; ip_proto:!6; priority:2; metadata:created_at 2026_09_26, deployment agent_guard, category perimeter; sid:9101006; rev:1;)

