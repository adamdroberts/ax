drop tcp any any -> any any (msg:"EXEC Windows rundll32 JavaScript execution"; pcre:"/\brundll32(?:\.exe)?\s+javascript:/i"; http_client_body; classtype:"web-application-attack"; sid:1100313; rev:1;)
drop tcp any any -> any any (msg:"EXEC Base64 decoded shell pipeline"; pcre:"/\bbase64\s+(-d|--decode)\b.{0,60}\|\s*(sh|bash|zsh)\b/i"; http_client_body; classtype:"web-application-attack"; sid:1100314; rev:1;)
