drop tcp any any -> any any (msg:"RECON Package registry credential file retrieval"; pcre:"//(\.npmrc|\.pypirc|\.netrc)([?#]|$)/i"; http_uri; classtype:"web-application-attack"; sid:1101007; rev:1;)
alert tcp any any -> any any (msg:"RECON Framework debugger console"; pcre:"//(console|_ignition/execute-solution|_profiler/phpinfo)([/?#]|$)/i"; http_uri; classtype:"policy-violation"; sid:1101008; rev:1;)
drop tcp any any -> any any (msg:"RECON Spring Actuator secret endpoints"; pcre:"//actuator/(env|heapdump|configprops|mappings)([/?#]|$)/i"; http_uri; classtype:"web-application-attack"; sid:1101009; rev:1;)
alert tcp any any -> any any (msg:"RECON Container daemon administrative endpoint"; pcre:"//(v\d+\.\d+/)?containers/(json|create)([?#]|$)/i"; http_uri; classtype:"policy-violation"; sid:1101010; rev:1;)
drop tcp any any -> any any (msg:"RECON Kubernetes service-account token path"; pcre:"//var/run/secrets/kubernetes\.io/serviceaccount/token\b/i"; http_client_body; classtype:"web-application-attack"; sid:1101011; rev:1;)
alert tcp any any -> any any (msg:"RECON Browser cookie credential database path"; pcre:"//(Login Data|Network/Cookies|Cookies|logins\.json|key4\.db)([\x22\x27\s]|$)/i"; http_client_body; classtype:"policy-violation"; sid:1101012; rev:1;)
block tcp any any -> any any (msg:"STRICT HTTP CONNECT method"; pcre:"/^CONNECT$/i"; http_method; classtype:"policy-violation"; sid:1200127; rev:1;)
alert tcp any any -> any any (msg:"STRICT HTTP DELETE method"; pcre:"/^DELETE$/i"; http_method; classtype:"policy-violation"; sid:1200126; rev:1;)
alert tcp any any -> any any (msg:"STRICT WebDAV resource mutation method"; pcre:"/^(COPY|MOVE|MKCOL|PROPPATCH|LOCK|UNLOCK)$/i"; http_method; classtype:"policy-violation"; sid:1200128; rev:1;)
alert tcp any any -> any any (msg:"STRICT Shell interpreter invocation"; pcre:"/\b(bash|sh|zsh|dash|cmd(?:\.exe)?|powershell(?:\.exe)?|pwsh)\s+(-c\b|/c\b|-command\b|-encodedcommand\b)/i"; http_client_body; classtype:"policy-violation"; sid:1200106; rev:1;)
alert tcp any any -> any any (msg:"STRICT Recursive deletion command"; pcre:"/\brm\s+(-[A-Za-z]*r[A-Za-z]*|--recursive)\b/i"; http_client_body; classtype:"policy-violation"; sid:1200117; rev:1;)
alert tcp any any -> any any (msg:"STRICT Terraform destructive operation"; pcre:"/\bterraform\s+(destroy|apply)\b/i"; http_client_body; classtype:"policy-violation"; sid:1200116; rev:1;)


# DNS escape controls: exact routing remains the boundary. See docs/dns-proxy.md.
drop tcp any any -> any any (msg:"AX DNS wire query parameter over HTTP"; pcre:"/[?&;]dns=[^&;]{16}/i"; http_uri; classtype:"policy-violation"; sid:1101101; rev:1;)
drop tcp any any -> any any (msg:"AX DNS response media negotiation over HTTP"; pcre:"/(^|[ ,])application\/(dns-message|dns-json|oblivious-dns-message)([;, ]|$)/i"; http_header:field accept; classtype:"policy-violation"; sid:1101102; rev:1;)
drop tcp any any -> any any (msg:"AX JSON or oblivious DNS content type"; pcre:"/^application\/(dns-json|oblivious-dns-message)([; ]|$)/i"; http_header:field content-type; classtype:"policy-violation"; sid:1101103; rev:1;)
drop tcp any any -> any any (msg:"AX DNS wire query in form body"; pcre:"/(^|[&;\s])dns=[A-Za-z0-9_+\/%=-]{16}/i"; http_client_body; classtype:"policy-violation"; sid:1101104; rev:1;)
drop tcp any any -> any any (msg:"AX DNS wire query in JSON envelope"; pcre:"/\x22dns\x22\s*:\s*\x22[A-Za-z0-9_+\/-]{16}/i"; http_client_body; classtype:"policy-violation"; sid:1101105; rev:1;)
drop tcp any any -> any any (msg:"AX JSON DNS resolution API request"; pcre:"/\/resolve([/?]|$)/i"; http_uri; pcre:"/[?&;]name=[^&;]+/i"; http_uri; classtype:"policy-violation"; sid:1101106; rev:1;)
drop tcp any any -> any any (msg:"AX Oblivious or alternate DNS resolution route"; pcre:"/\/(odoh|dns-resolve|resolve-dns)([/?]|$)/i"; http_uri; classtype:"policy-violation"; sid:1101107; rev:1;)
drop tcp any any -> any any (msg:"AX DNS wire query disguised as HTTP body"; pcre:"/^.{2}[\x00-\x7f].\x00[\x01-\xff]\x00{4}/s"; http_raw_body; classtype:"policy-violation"; sid:1101108; rev:1;)

