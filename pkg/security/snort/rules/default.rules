# --- HTTP protocol abuse and request-routing ambiguity ---
drop tcp any any -> any any (msg:"PROTO HTTP method TRACE"; pcre:"/^TRACE$/i"; http_method; classtype:"web-application-attack"; sid:1100901; rev:1;)
drop tcp any any -> any any (msg:"PROTO HTTP method TRACK"; pcre:"/^TRACK$/i"; http_method; classtype:"web-application-attack"; sid:1100902; rev:1;)
alert tcp any any -> any any (msg:"PROTO Transfer-Encoding and Content-Length combination"; pcre:"/(?m)^transfer-encoding:[^\r\n]+[\s\S]*^content-length:|^content-length:[^\r\n]+[\s\S]*^transfer-encoding:/i"; http_header; classtype:"policy-violation"; sid:1100903; rev:1;)
alert tcp any any -> any any (msg:"PROTO Header value newline injection"; pcre:"/[\r\n](host|authorization|x-forwarded-host)\s*:/i"; http_client_body; classtype:"policy-violation"; sid:1100904; rev:1;)
alert tcp any any -> any any (msg:"PROTO HTTP request embedded in body"; pcre:"/(^|\r\n)(GET|POST|PUT|DELETE)\s+/[^\r\n]*\s+HTTP/1\.[01]\r\nHost:/i"; http_client_body; classtype:"policy-violation"; sid:1100905; rev:1;)
alert tcp any any -> any any (msg:"PROTO HTTP2 connection preface in body"; pcre:"/PRI \* HTTP/2\.0\r\n\r\nSM\r\n\r\n/"; http_client_body; classtype:"policy-violation"; sid:1100906; rev:1;)
drop tcp any any -> any any (msg:"PROTO Host header metadata destination"; pcre:"/(?m)^host\s*:\s*(169\.254\.169\.254|metadata\.google\.internal)([:\s]|$)/i"; http_header; classtype:"web-application-attack"; sid:1100907; rev:1;)
alert tcp any any -> any any (msg:"PROTO Routing override header to loopback"; pcre:"/(?m)^(x-forwarded-host|x-original-host|x-host)\s*:\s*(localhost|127\.0\.0\.1|169\.254\.169\.254)([:\s]|$)/i"; http_header; classtype:"policy-violation"; sid:1100908; rev:1;)
alert tcp any any -> any any (msg:"PROTO HTTP method override to destructive verb"; pcre:"/(?m)^x-http-method-override\s*:\s*(DELETE|PUT|PATCH)\b/i"; http_header; classtype:"policy-violation"; sid:1100909; rev:1;)
drop tcp any any -> any any (msg:"PROTO PHP CGI code execution parameter"; pcre:"/[?&]-d\s*(allow_url_include|auto_prepend_file)\s*=/i"; http_uri; classtype:"web-application-attack"; sid:1100910; rev:1;)
drop tcp any any -> any any (msg:"PROTO Embedded NUL in resource URI"; pcre:"/(%00|\x00)/i"; http_uri; classtype:"web-application-attack"; sid:1100911; rev:1;)
drop tcp any any -> any any (msg:"PROTO Backslash directory traversal"; pcre:"/\.\.\\\.\.\\/i"; http_uri; classtype:"web-application-attack"; sid:1100912; rev:1;)

