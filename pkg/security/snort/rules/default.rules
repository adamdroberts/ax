drop tcp any any -> any any (msg:"EXFIL URI Unix shadow password hash"; pcre:"/\b[a-z_][a-z0-9_-]*:\$(1|2[aby]|5|6|y)\$[^:\s]{8,}:/i"; http_uri; classtype:"web-application-attack"; sid:1100234; rev:1;)

# --- Shell execution, reverse channels, and credential dumping ---
drop tcp any any -> any any (msg:"EXEC Bash interactive reverse channel"; pcre:"/\bbash\s+-[a-z]*i\b.{0,80}(>&|/dev/(tcp|udp)/)/i"; http_client_body; classtype:"web-application-attack"; sid:1100301; rev:1;)
drop tcp any any -> any any (msg:"EXEC Socat shell bridge"; pcre:"/\bsocat\b.{0,160}\b(exec|system):[^\r\n]*(/bin/(sh|bash)|cmd\.exe)/i"; http_client_body; classtype:"web-application-attack"; sid:1100302; rev:1;)
drop tcp any any -> any any (msg:"EXEC FIFO netcat reverse channel"; pcre:"/\bmkfifo\b.{0,200}\b(nc|ncat|netcat)\b/is"; http_client_body; classtype:"web-application-attack"; sid:1100303; rev:1;)
drop tcp any any -> any any (msg:"EXEC Python socket subprocess shell"; pcre:"/\bsocket\.(socket|create_connection)\s*\(.{0,300}\b(subprocess\.(call|Popen)|os\.dup2)\s*\(/is"; http_client_body; classtype:"web-application-attack"; sid:1100304; rev:1;)
drop tcp any any -> any any (msg:"EXEC Perl socket shell bridge"; pcre:"/\b(IO::Socket::INET|Socket;).{0,200}(exec\s*\(?\s*[\x22\x27]/bin/(sh|bash)|open\s*\(?\s*STDIN)/is"; http_client_body; classtype:"web-application-attack"; sid:1100305; rev:1;)
drop tcp any any -> any any (msg:"EXEC Ruby TCP shell bridge"; pcre:"/\bTCPSocket\.(new|open)\b.{0,200}\b(exec|spawn)\s*\(?\s*[\x22\x27]/bin/(sh|bash)/is"; http_client_body; classtype:"web-application-attack"; sid:1100306; rev:1;)
alert tcp any any -> any any (msg:"EXEC Node child-process shell"; pcre:"/\b(require\s*\(\s*[\x22\x27]child_process|child_process\.(exec|spawn))/i"; http_client_body; classtype:"policy-violation"; sid:1100307; rev:1;)
alert tcp any any -> any any (msg:"EXEC PowerShell encoded command"; pcre:"/\b(powershell|pwsh)(\.exe)?\b.{0,120}\s-(enc|encodedcommand)\s+[A-Za-z0-9+/]{16,}={0,2}/i"; http_client_body; classtype:"policy-violation"; sid:1100308; rev:1;)
drop tcp any any -> any any (msg:"EXEC PowerShell download and evaluate"; pcre:"/\b(iex|Invoke-Expression)\b.{0,120}\b(DownloadString|Invoke-WebRequest|iwr)\b/i"; http_client_body; classtype:"web-application-attack"; sid:1100309; rev:1;)
alert tcp any any -> any any (msg:"EXEC Windows certutil download"; pcre:"/\bcertutil(?:\.exe)?\s+.{0,80}-(urlcache|verifyctl)\b.{0,80}https?:///i"; http_client_body; classtype:"policy-violation"; sid:1100310; rev:1;)
drop tcp any any -> any any (msg:"EXEC Windows mshta remote payload"; pcre:"/\bmshta(?:\.exe)?\s+(https?://|javascript:|vbscript:)/i"; http_client_body; classtype:"web-application-attack"; sid:1100311; rev:1;)
