#
# AX request-inspection rules, written for the AX supported Snort-style subset.
# These are original signatures, not an imported vendor or community ruleset.
# Stable SID allocation: 1000001-1000060 historical baseline; 110xxxx default;
# 120xxxx original strict-policy IDs; some now also provide default telemetry.
# 91xxxxx imported Agent Guard IDs. A SID identifies one behavior, not a severity rank.
#
# Scope: requests visible to this HTTP proxy. TLS, DNS, local execution, responses,
# arbitrary encodings, and authorized-looking abuse require separate controls.
# Signatures cannot establish intent or completely prevent hostile agent actions.
# BODY rules inspect request bodies; URI rules inspect destinations/path/query;
# HEADER rules deliberately inspect headers. Secret patterns avoid auth headers.
# Decoded matching is bounded by the engine. Base64 is not globally decoded.
# Legacy regex wildcard spans are capped at 256 or 512 characters for predictable
# Python matching cost. Separating an attack across larger spans can evade a SID.
# Alerts preserve visibility for ambiguous prompts and ordinary administration.
# Drops may match security research, quoted examples, or authorized operations;
# tune by SID and use destination/tool authorization for enforcement boundaries.
# Every SID has positive and benign near-miss fixtures in ../testdata/rule_cases.json.

# ==============================================================================
# AX Historical Baseline Signatures (stable original SIDs)
# ==============================================================================

# --- Remote Code Execution (RCE) & Command Injection ---
drop tcp any any -> any any (msg:"EXPLOIT Log4Shell JNDI injection attempt"; content:"${jndi:"; nocase; classtype:"attempted-admin"; sid:1000001; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT Log4Shell obfuscated JNDI pattern"; pcre:"/\$\{[^}]{0,256}jndi[^}]{0,256}:/i"; classtype:"attempted-admin"; sid:1000002; rev:2;)
drop tcp any any -> any any (msg:"EXPLOIT Reverse Shell /dev/tcp payload"; content:"/dev/tcp/"; nocase; classtype:"attempted-admin"; sid:1000003; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT Netcat reverse shell execution"; pcre:"/nc(\.traditional)?\s+.{0,512}-e\s+(\/bin\/(ba)?sh)/i"; classtype:"attempted-admin"; sid:1000004; rev:2;)
drop tcp any any -> any any (msg:"EXPLOIT Remote pipe to shell execution"; pcre:"/(curl|wget)\s+.{0,512}\|\s*(ba)?sh/i"; classtype:"attempted-admin"; sid:1000005; rev:2;)
drop tcp any any -> any any (msg:"EXPLOIT Shell command injection attempt"; pcre:"/(;|\||`|\$\().{0,512}\b(cat\s+\/etc\/passwd|whoami|id|uname\s+-a|rm\s+-rf)/i"; classtype:"attempted-admin"; sid:1000006; rev:2;)

# --- Known Framework Exploit Indicators ---
drop tcp any any -> any any (msg:"EXPLOIT Spring4Shell classLoader manipulation"; content:"class.module.classLoader"; nocase; classtype:"attempted-admin"; sid:1000010; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT Apache Struts OGNL injection"; content:"#_memberAccess"; nocase; classtype:"attempted-admin"; sid:1000011; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT PHP CGI argument injection"; pcre:"/\?-d\+allow_url_include/i"; classtype:"attempted-admin"; sid:1000012; rev:1;)

# --- Path Traversal & Sensitive File Exposure ---
drop tcp any any -> any any (msg:"EXPLOIT Path Traversal directory climbing"; content:"../../"; http_uri; classtype:"web-application-attack"; sid:1000020; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT URL-encoded path traversal"; pcre:"/(\.\.%2f|\.\.%5c|%2e%2e%2f)/i"; http_uri; classtype:"web-application-attack"; sid:1000021; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT Sensitive system file access /etc/passwd"; content:"/etc/passwd"; nocase; classtype:"attempted-recon"; sid:1000022; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT Windows system file access"; pcre:"/(win\.ini|boot\.ini|system32\/config\/sam)/i"; classtype:"attempted-recon"; sid:1000023; rev:1;)

# --- Server-Side Request Forgery (SSRF) & Metadata Theft ---
drop tcp any any -> any any (msg:"ATTACK SSRF Cloud instance metadata probe"; content:"169.254.169.254"; http_uri; classtype:"bad-unknown"; sid:1000030; rev:1;)
drop tcp any any -> any any (msg:"ATTACK SSRF GCP metadata header probe"; content:"metadata.google.internal"; nocase; http_uri; classtype:"bad-unknown"; sid:1000031; rev:1;)
drop tcp any any -> any any (msg:"ATTACK SSRF Loopback service probe"; pcre:"/https?:\/\/(127\.0\.0\.1|localhost|0\.0\.0\.0|\[::1\])(:\d+)?(\/|$)/i"; http_uri; classtype:"bad-unknown"; sid:1000032; rev:1;)

# --- SQL Injection (SQLi) ---
drop tcp any any -> any any (msg:"EXPLOIT SQL Injection UNION SELECT"; pcre:"/union(\s+all)?\s+select/i"; classtype:"web-application-attack"; sid:1000040; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT SQL Injection classic OR tautology"; pcre:"/('\s*or\s+'?1'?\s*=\s*'?1|or\s+1\s*=\s*1\s*(--|#))/i"; classtype:"web-application-attack"; sid:1000041; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT SQL Injection stacked DROP/TRUNCATE query"; pcre:"/(;\s*drop\s+(table|database)|;\s*truncate\s+table)/i"; classtype:"web-application-attack"; sid:1000042; rev:1;)
drop tcp any any -> any any (msg:"EXPLOIT SQL Injection time delay"; pcre:"/(waitfor\s+delay\s+'|sleep\(\s*\d+\s*\)|benchmark\(\s*\d+\s*,)/i"; classtype:"web-application-attack"; sid:1000043; rev:1;)

# --- Cross-Site Scripting (XSS) & CRLF Injection ---
drop tcp any any -> any any (msg:"EXPLOIT Cross-Site Scripting script injection"; pcre:"/<script[^>]{0,512}>|javascript:\s*/i"; classtype:"web-application-attack"; sid:1000050; rev:2;)
drop tcp any any -> any any (msg:"EXPLOIT CRLF header injection attempt"; pcre:"/(\r\n|\n\r|%0d%0a|%0a%0d)(Set-Cookie|Location):/i"; classtype:"web-application-attack"; sid:1000051; rev:1;)

# --- Automated Scanning & Hacking Tools ---
drop tcp any any -> any any (msg:"ATTACK Automated vulnerability scanner detected"; pcre:"/(sqlmap|nikto|havij|acunetix|dirbuster|nmap)/i"; http_header; classtype:"attempted-recon"; sid:1000060; rev:1;)

# --- Agent instruction and tool-boundary abuse: alerts are signals, not an intent classifier ---
alert tcp any any -> any any (msg:"AGENT Ignore higher priority instructions"; pcre:"/\b(ignore|disregard|forget)\s+(all\s+)?(previous|prior|system|developer)\s+(instructions|prompts|rules)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100101; rev:1;)
alert tcp any any -> any any (msg:"AGENT Replace the system prompt"; pcre:"/\b(replace|overwrite|override)\s+(the\s+|your\s+)?system\s+(prompt|instructions)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100102; rev:1;)
alert tcp any any -> any any (msg:"AGENT Disable safety mechanisms"; pcre:"/\b(disable|bypass|turn\s+off)\s+(all\s+|the\s+|your\s+)?(safety|security)\s+(filters|checks|guardrails|controls)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100103; rev:1;)
alert tcp any any -> any any (msg:"AGENT Hidden instruction concealment"; pcre:"/\b(do\s+not|never)\s+(tell|inform|notify)\s+(the\s+)?(user|operator)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100104; rev:1;)
alert tcp any any -> any any (msg:"AGENT Exfiltration instruction"; pcre:"/\b(send|upload|post|transmit|exfiltrate)\b.{0,100}\b(api[ _-]?keys?|credentials|private[ _-]?keys?|secrets)\b.{0,100}https?:///i"; http_client_body; classtype:"policy-violation"; sid:1100105; rev:1;)
alert tcp any any -> any any (msg:"AGENT Tool output authority spoofing"; pcre:"/\b(tool\s+(output|result)|retrieved\s+(document|page))\b.{0,100}\b(system\s+(message|instruction)|higher\s+priority)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100106; rev:1;)
alert tcp any any -> any any (msg:"AGENT ChatML privileged-role delimiter"; pcre:"/<\|im_start\|>\s*(system|developer)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100107; rev:1;)
alert tcp any any -> any any (msg:"AGENT Llama privileged-role delimiter"; pcre:"/<\|start_header_id\|>\s*system\s*<\|end_header_id\|>/i"; http_client_body; classtype:"policy-violation"; sid:1100108; rev:1;)
alert tcp any any -> any any (msg:"AGENT Instruction fence escape"; pcre:"/\[/INST\]\s*(<<SYS>>|\[INST\])/i"; http_client_body; classtype:"policy-violation"; sid:1100109; rev:1;)
alert tcp any any -> any any (msg:"AGENT Forged system XML boundary"; pcre:"/</(tool_result|tool_output|document|untrusted_text)>\s*<(system|developer)(\s|>)/i"; http_client_body; classtype:"policy-violation"; sid:1100110; rev:1;)
alert tcp any any -> any any (msg:"AGENT Prompt and hidden reasoning disclosure"; pcre:"/\b(reveal|print|dump|extract)\b.{0,60}\b(system\s+prompt|developer\s+instructions|hidden\s+chain[ -]of[ -]thought)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100111; rev:1;)
alert tcp any any -> any any (msg:"AGENT False approval assertion"; pcre:"/\b(user|operator|administrator)\s+(has\s+)?(already\s+)?(approved|authorized)\b.{0,80}\b(skip|bypass|ignore)\b.{0,40}\b(confirmation|approval|permission)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100112; rev:1;)
alert tcp any any -> any any (msg:"AGENT Tool invocation injection in document"; pcre:"/<(tool_call|function_call)>\s*\{/i"; http_client_body; classtype:"policy-violation"; sid:1100113; rev:1;)
alert tcp any any -> any any (msg:"AGENT Forged assistant tool recipient"; pcre:"/<\|im_start\|>\s*assistant\s+to=/i"; http_client_body; classtype:"policy-violation"; sid:1100114; rev:1;)
alert tcp any any -> any any (msg:"AGENT Safety mode jailbreak request"; pcre:"/\b(enable|enter|activate)\s+(unrestricted|jailbreak|god|developer)\s+mode\b/i"; http_client_body; classtype:"policy-violation"; sid:1100115; rev:1;)
alert tcp any any -> any any (msg:"AGENT Guardrail environment override"; pcre:"/\b(DISABLE_GUARDRAILS|SKIP_SAFETY_CHECKS|BYPASS_APPROVALS)\s*[:=]\s*(true|1)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100116; rev:1;)
alert tcp any any -> any any (msg:"AGENT Approval flag bypass"; pcre:"/--(dangerously-skip-permissions|dangerously-bypass-approvals-and-sandbox|no-sandbox)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100117; rev:1;)
alert tcp any any -> any any (msg:"AGENT Instruction-file poisoning request"; pcre:"/\b(write|overwrite|append|modify)\b.{0,100}\b(AGENTS\.md|CLAUDE\.md|GEMINI\.md|SKILL\.md)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100118; rev:1;)
alert tcp any any -> any any (msg:"AGENT Memory poisoning instruction"; pcre:"/\b(remember|persist|save)\b.{0,80}\b(future\s+(sessions|conversations)|long[ -]term\s+memory)\b.{0,80}\b(ignore|bypass|override)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100119; rev:1;)
alert tcp any any -> any any (msg:"AGENT Safety audit suppression"; pcre:"/\b(disable|delete|suppress|erase)\b.{0,50}\b(audit\s+(logs?|trail)|security\s+telemetry)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100120; rev:1;)
alert tcp any any -> any any (msg:"AGENT Hidden external image beacon"; pcre:"/!\[[^\]]{0,200}\]\(https?://[^)\s]+[?&](token|secret|key|data)=/i"; http_client_body; classtype:"policy-violation"; sid:1100121; rev:1;)
alert tcp any any -> any any (msg:"AGENT Instructions in HTML comment"; pcre:"/<!--.{0,100}\b(ignore|override|disregard)\b.{0,80}\b(instructions|system|user)\b/is"; http_client_body; classtype:"policy-violation"; sid:1100122; rev:1;)
alert tcp any any -> any any (msg:"AGENT Forged human confirmation tag"; pcre:"/<(user_approval|human_approval|permission_granted)>\s*(true|approved|yes)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100123; rev:1;)
alert tcp any any -> any any (msg:"AGENT Autonomous replication instruction"; pcre:"/\b(copy|replicate|spawn)\b.{0,60}\b(yourself|agent\s+instances)\b.{0,80}\b(other\s+(hosts|servers)|without\s+permission)\b/i"; http_client_body; classtype:"policy-violation"; sid:1100124; rev:1;)

# --- Secret material in request bodies only; ordinary Authorization headers are excluded ---
drop tcp any any -> any any (msg:"EXFIL PEM private key material"; pcre:"/-----BEGIN (RSA |EC |DSA |OPENSSH |ENCRYPTED )?PRIVATE KEY-----/i"; http_client_body; classtype:"web-application-attack"; sid:1100201; rev:1;)
drop tcp any any -> any any (msg:"EXFIL PGP private key block"; pcre:"/-----BEGIN PGP PRIVATE KEY BLOCK-----/i"; http_client_body; classtype:"web-application-attack"; sid:1100202; rev:1;)
drop tcp any any -> any any (msg:"EXFIL AWS access key identifier in body"; pcre:"/\b(AKIA|ASIA)[A-Z0-9]{16}\b/"; http_client_body; classtype:"web-application-attack"; sid:1100203; rev:1;)
drop tcp any any -> any any (msg:"EXFIL AWS secret access key assignment"; pcre:"/\baws_secret_access_key[\x22\x27]?\s*[=:]\s*[\x22\x27]?[A-Za-z0-9/+=]{30,}/i"; http_client_body; classtype:"web-application-attack"; sid:1100204; rev:1;)
drop tcp any any -> any any (msg:"EXFIL GitHub classic token in body"; pcre:"/\bgh[pousr]_[A-Za-z0-9]{36,255}\b/"; http_client_body; classtype:"web-application-attack"; sid:1100205; rev:1;)
drop tcp any any -> any any (msg:"EXFIL GitHub fine-grained token in body"; pcre:"/\bgithub_pat_[A-Za-z0-9_]{50,255}\b/"; http_client_body; classtype:"web-application-attack"; sid:1100206; rev:1;)
drop tcp any any -> any any (msg:"EXFIL GitLab personal token in body"; pcre:"/\bglpat-[A-Za-z0-9_-]{20,255}\b/"; http_client_body; classtype:"web-application-attack"; sid:1100207; rev:1;)
drop tcp any any -> any any (msg:"EXFIL Slack token in body"; pcre:"/\bxox[baprs]-[A-Za-z0-9-]{20,255}\b/"; http_client_body; classtype:"web-application-attack"; sid:1100208; rev:1;)
drop tcp any any -> any any (msg:"EXFIL Stripe live secret key in body"; pcre:"/\b[sr]k_live_[A-Za-z0-9]{16,255}\b/"; http_client_body; classtype:"web-application-attack"; sid:1100209; rev:1;)
drop tcp any any -> any any (msg:"EXFIL npm access token in body"; pcre:"/\bnpm_[A-Za-z0-9]{36,255}\b/"; http_client_body; classtype:"web-application-attack"; sid:1100210; rev:1;)
alert tcp any any -> any any (msg:"EXFIL Google service-account key identifier in body"; pcre:"/\x22private_key_id\x22\s*:\s*\x22[a-f0-9]{40}\x22/i"; http_client_body; classtype:"policy-violation"; sid:1100211; rev:1;)
drop tcp any any -> any any (msg:"EXFIL Database connection string with password"; pcre:"/\b(postgres(?:ql)?|mysql|mongodb(?:\+srv)?|redis)://[^:/\s]+:[^@/\s]{4,}@/i"; http_client_body; classtype:"web-application-attack"; sid:1100212; rev:1;)
drop tcp any any -> any any (msg:"EXFIL Azure storage account key assignment"; pcre:"/\bAccountKey=[A-Za-z0-9+/]{40,}={0,2}/i"; http_client_body; classtype:"web-application-attack"; sid:1100213; rev:1;)
drop tcp any any -> any any (msg:"EXFIL Windows credential hash record"; pcre:"/\b[^:\s]{1,64}:\d{1,10}:[a-f0-9]{32}:[a-f0-9]{32}:/i"; http_client_body; classtype:"web-application-attack"; sid:1100214; rev:1;)
drop tcp any any -> any any (msg:"EXFIL Unix shadow password hash"; pcre:"/\b[a-z_][a-z0-9_-]*:\$(1|2[aby]|5|6|y)\$[^:\s]{8,}:/i"; http_client_body; classtype:"web-application-attack"; sid:1100215; rev:1;)
drop tcp any any -> any any (msg:"EXFIL Secret-bearing query parameter"; pcre:"/[?&](aws_secret_access_key|private_key|client_secret|refresh_token)=[^&#\s]{16,}/i"; http_uri; classtype:"web-application-attack"; sid:1100216; rev:1;)

